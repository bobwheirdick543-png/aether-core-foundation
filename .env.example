# Aether — Supabase
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Server-only bootstrap administrator identity.
# After the account signs in successfully through Supabase Auth, Aether permanently
# grants that authenticated account the admin role. Do not expose this as VITE_*.
AETHER_ADMIN_EMAIL="YOUR_BOOTSTRAP_ADMIN_EMAIL"

# Server-only secret for recoverable AAX API-key secrets.
# Any non-empty high-entropy secret is accepted; Aether derives a stable 32-byte key with HKDF.
AETHER_API_KEY_ENCRYPTION_KEY="YOUR_SERVER_ONLY_ENCRYPTION_SECRET"

# Optional dedicated server-only encryption key for administrator-managed provider credentials.
# If omitted, Aether derives a domain-separated provider-vault key from AETHER_API_KEY_ENCRYPTION_KEY.
AETHER_PROVIDER_CREDENTIAL_ENCRYPTION_KEY=""

# AAX provider environment fallback. Database-managed provider credentials can override these per purpose.
XAI_API_KEY=""
OPENROUTER_API_KEY=""
AETHER_XAI_BASE_URL="https://api.x.ai/v1"
AETHER_AAX_API_KEY=""
AETHER_AAX_BASE_URL=""

# Optional email delivery
AETHER_EMAIL_PROVIDER="resend"
AETHER_EMAIL_API_KEY=""
AETHER_EMAIL_FROM=""

# Server-only centralized live web-search credential (Exa). Never expose as VITE_*.
EXA_API_KEY=""

# Optional runtime/application settings
PORT="3000"
